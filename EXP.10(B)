SELECTION SOR- 

def selection_sort(arr):
    n = len(arr)
    for i in range(n):
        min_idx = i
        for j in range(i+1, n):
            if arr[j] < arr[min_idx]:
                min_idx = j
        arr[i], arr[min_idx] = arr[min_idx], arr[i]

arr1 = [64, 25, 12, 22, 11]
selection_sort(arr1)
print("Selection Sort Result:", arr1)


INSERTION SORT -- 

def insertion_sort(arr):
    for i in range(1, len(arr)):
        key = arr[i]
        j = i - 1
        while j >= 0 and key < arr[j]:
            arr[j + 1] = arr[j]
            j -= 1
        arr[j + 1] = key

arr2 = [64, 25, 12, 22, 11]
insertion_sort(arr2)
print("Insertion Sort Result:", arr2)
