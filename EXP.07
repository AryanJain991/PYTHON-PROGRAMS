file_path = "sample.c"  # or use "sample.txt"

char_count = {}

with open(file_path, 'r') as file:
    content = file.read()
    for char in content:
        if char in char_count:
            char_count[char] += 1
        else:
            char_count[char] = 1

print("Character frequency:")
for char, count in char_count.items():
    print(f"{repr(char)}: {count}")
